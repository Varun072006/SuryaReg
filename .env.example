# SuryaReg (SELENE-REG) Environment Configuration
# SIH-26166 Lunar Image Registration Mission Workstation

# Server Configuration
PORT=5173
HOST=0.0.0.0
NODE_ENV=development

# Database Settings
DATA_DIR=backend/data
DB_PATH=backend/data/suryareg.db

# CORS Allowed Origins (comma-separated, or * in dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate Limiting Configuration 
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600

# Logging Level: DEBUG | INFO | ENGINE | WARN | ERROR 
LOG_LEVEL=INFO
